# GrowthPilot Environment Configuration (Phase 1 & Phase 2)

# ==========================================
# 1. Supabase Postgres Configuration
# ==========================================
# For local SQLite development (default):
# DATABASE_URL=sqlite:///./data/growthpilot.db
#
# For Supabase Postgres:
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DEMO_TENANT_ID=tenant_demo_001

# ==========================================
# 2. Redis Configuration (Event Queue & Cache)
# ==========================================
# For local Redis or Upstash Redis:
REDIS_URL=redis://localhost:6379/0

# ==========================================
# 3. Razorpay Test-Mode Credentials
# ==========================================
# Get your Test Keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_NEW_KEY_HERE
RAZORPAY_KEY_SECRET=NEW_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ==========================================
# 4. Optional LLM / API Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key
